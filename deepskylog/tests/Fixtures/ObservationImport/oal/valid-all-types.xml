  <eyepieces>
    <eyepiece id="eyepiece-1"><model>Example 10mm</model><focalLength>10</focalLength><apparentFOV unit="deg">82</apparentFOV></eyepiece>
  </eyepieces>
  <lenses>
    <lens id="lens-1"><model>Example Barlow 2x</model><factor>2</factor></lens>
  </lenses>
  <filters/><imagers/>
  <!-- 1: a deep-sky object -->
  <observation id="observation-1">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-deepsky</target>
    <begin>2026-09-12T21:30:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>Deep-sky object: a bright core and a dust lane.</description></result>
  </observation>
  <!-- 2: a comet -->
  <observation id="observation-2">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-comet</target>
    <begin>2024-03-20T19:30:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>Comet: low in the west, with a faint tail.</description></result>
  </observation>
  <!-- 3: the Sun -->
  <observation id="observation-3">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-sun</target>
    <begin>2026-06-21T14:00:00+02:00</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>The Sun through a full-aperture solar filter: two sunspot groups.</description></result>
  </observation>
  <!-- 4: a planet -->
  <observation id="observation-4">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-planet</target>
    <begin>2026-01-10T23:00:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <lens>lens-1</lens>
    <result lang="en"><description>Planet: two dark belts and the Great Red Spot.</description></result>
  </observation>
  <!-- 5: the Moon with the naked eye (no scope) -->
  <observation id="observation-5">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-moon</target>
    <begin>2026-09-25T21:00:00Z</begin>
    <result lang="en"><description>The Moon: almost full, rising in the east.</description></result>
  </observation>
  <!-- 6: a lunar feature -->
  <observation id="observation-6">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-lunar-feature</target>
    <begin>2026-09-25T21:15:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>Lunar feature: terraced walls and central peaks.</description></result>
  </observation>
