<?xml version="1.0" encoding="UTF-8"?>
<oal:observations xmlns:oal="http://groups.google.com/group/openastronomylog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.1" xsi:schemaLocation="http://groups.google.com/group/openastronomylog oal21.xsd">
  <observers>
    <observer id="observer-1"><name>Example</name><surname>Observer</surname></observer>
  </observers>
  <sites>
    <site id="site-1"><name>Example Site</name><longitude unit="deg">4.70</longitude><latitude unit="deg">50.88</latitude><elevation>30</elevation><timezone>60</timezone></site>
  </sites>
  <sessions/>
  <targets>
    <target id="target-deepsky" xsi:type="oal:deepSkyGX"><datasource>DeepskyLog</datasource><name>M 31</name></target>
    <target id="target-comet" xsi:type="oal:CometTargetType"><datasource>DeepskyLog</datasource><name>12P/Pons-Brooks</name></target>
    <target id="target-sun" xsi:type="oal:SunTargetType"><datasource>DeepskyLog</datasource><name>Sun</name></target>
    <target id="target-planet" xsi:type="oal:PlanetTargetType"><datasource>DeepskyLog</datasource><name>Jupiter</name></target>
    <target id="target-moon" xsi:type="oal:MoonTargetType"><datasource>DeepskyLog</datasource><name>Moon</name></target>
    <target id="target-lunar-feature"><datasource>DeepskyLog</datasource><name>Copernicus</name><notes>DeepskyLog:target_table=lunar_features;target_key=copernicus;target_type=lunar</notes></target>
    <target id="target-planet-moon" xsi:type="oal:MoonTargetType"><datasource>DeepskyLog</datasource><name>Io</name></target>
    <target id="target-asteroid" xsi:type="oal:MinorPlanetTargetType"><datasource>DeepskyLog</datasource><name>Vesta</name></target>
