  <observation id="observation-7">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-planet-moon</target>
    <begin>2026-01-10T23:15:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <lens>lens-1</lens>
    <result lang="en"><description>Moon of a planet: Io, a tiny disk next to Jupiter.</description></result>
  </observation>
  <!-- 8: an asteroid -->
  <observation id="observation-8">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-asteroid</target>
    <begin>2026-01-10T23:30:00Z</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>Asteroid: a star-like point that had moved after an hour.</description></result>
  </observation>
</oal:observations>
