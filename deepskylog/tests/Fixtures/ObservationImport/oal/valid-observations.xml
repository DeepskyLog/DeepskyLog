<?xml version="1.0" encoding="UTF-8"?>
<oal:observations xmlns:oal="http://groups.google.com/group/openastronomylog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.1" xsi:schemaLocation="http://groups.google.com/group/openastronomylog oal21.xsd">
  <observers>
    <observer id="observer-1"><name>Example</name><surname>Observer</surname></observer>
  </observers>
  <sites>
    <site id="site-1"><name>Example Site</name><longitude unit="deg">4.70</longitude><latitude unit="deg">50.88</latitude><elevation>30</elevation><timezone>60</timezone></site>
    <site id="site-2"><name>Example Remote Site</name><longitude unit="deg">7.50</longitude><latitude unit="deg">46.00</latitude><elevation>2100</elevation><timezone>60</timezone></site>
  </sites>
  <sessions/>
  <targets>
    <target id="target-m31" xsi:type="oal:deepSkyGX"><datasource>DeepskyLog</datasource><name>M 31</name></target>
    <target id="target-m13" xsi:type="oal:deepSkyGC"><datasource>DeepskyLog</datasource><name>m13</name></target>
    <target id="target-m42" xsi:type="oal:deepSkyGN"><datasource>DeepskyLog</datasource><name>M 42</name></target>
    <target id="target-m45" xsi:type="oal:deepSkyOC"><datasource>DeepskyLog</datasource><name>M 45</name></target>
    <target id="target-m81" xsi:type="oal:deepSkyGX"><datasource>DeepskyLog</datasource><name>M81</name></target>
  </targets>
  <scopes>
    <scope id="scope-1" xsi:type="oal:scopeType"><model>Example Dobson 250</model><type>N</type><aperture>250</aperture><focalLength>1200</focalLength></scope>
    <scope id="scope-2" xsi:type="oal:scopeType"><model>Refractor 102</model><type>R</type><vendor>Example</vendor><aperture>102</aperture><focalLength>714</focalLength></scope>
  </scopes>
  <eyepieces>
    <eyepiece id="eyepiece-1"><model>Example 10mm</model><focalLength>10</focalLength><apparentFOV unit="deg">82</apparentFOV></eyepiece>
  </eyepieces>
  <lenses>
    <lens id="lens-1"><model>Example Barlow 2x</model><factor>2</factor></lens>
  </lenses>
  <filters>
    <filter id="filter-1"><model>Example UHC</model><type>narrow band</type></filter>
  </filters>
  <imagers/>
  <!-- 1: full observation, local time with an offset (21:30 UT) -->
  <observation id="observation-1">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-m31</target>
    <begin>2026-09-12T23:30:00+02:00</begin>
    <faintestStar>6.2</faintestStar>
    <sky-quality unit="mags-per-squarearcsec">20.85</sky-quality>
    <seeing>2</seeing>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <result lang="en"><description>Bright core, dust lane visible with averted vision.</description></result>
  </observation>
  <!-- 2: UT with Z, eyepiece and Barlow, deep-sky findings with a rating -->
  <observation id="observation-2">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-m13</target>
    <begin>2026-07-04T22:00:00Z</begin>
    <seeing>3</seeing>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <lens>lens-1</lens>
    <result xsi:type="oal:findingsDeepSkyType" lang="en"><description>Resolved to the core at 240x.</description><rating>1</rating></result>
  </observation>
  <!-- 3: no offset (taken as UT), a filter, two results of which the first is empty -->
  <observation id="observation-3">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-m42</target>
    <begin>2026-01-15T21:00:00</begin>
    <scope>scope-1</scope>
    <eyepiece>eyepiece-1</eyepiece>
    <filter>filter-1</filter>
    <result lang="en"><description></description></result>
    <result lang="nl"><description>De vleugels van de nevel zijn zeer uitgebreid met het UHC-filter.</description></result>
  </observation>
  <!-- 4: naked eye (no scope) -->
  <observation id="observation-4">
    <observer>observer-1</observer>
    <site>site-1</site>
    <target>target-m45</target>
    <begin>2026-10-10T23:00:00Z</begin>
    <faintestStar>6.3</faintestStar>
    <result lang="en"><description>Seven stars counted with the naked eye.</description></result>
  </observation>
  <!-- 5: a site and a scope that are not in the account yet (both created), target written without a space -->
  <observation id="observation-5">
    <observer>observer-1</observer>
    <site>site-2</site>
    <target>target-m81</target>
    <begin>2026-03-20T20:15:30Z</begin>
    <scope>scope-2</scope>
    <result lang="en"><description>Bright oval with a stellar nucleus.</description></result>
  </observation>
</oal:observations>
